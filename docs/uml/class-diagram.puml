
@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam linetype ortho

title Қазпошта сәлемдемелерін жеткізу және трекинг жүйесі 

abstract class Person {
  - id: int
  - fullName: String
  - phone: String
  + getFullName(): String
  + getPhone(): String
}

class Sender {
  - address: String
  + sendParcel(): void
}

class Recipient {
  - address: String
  + receiveParcel(): void
}

class Parcel {
  - trackingNumber: String
  - weight: double
  - createdAt: LocalDateTime
  - status: DeliveryStatus
  + getTrackingNumber(): String
  + updateStatus(status: DeliveryStatus): void
}

class PostOffice {
  - officeId: int
  - address: String
  - city: String
  + getOfficeInfo(): String
}

class TrackingEvent {
  - eventId: int
  - status: DeliveryStatus
  - eventDate: LocalDateTime
  - description: String
  + getEventInfo(): String
}

enum DeliveryStatus {
  REGISTERED
  ACCEPTED
  IN_TRANSIT
  ARRIVED_AT_OFFICE
  DELIVERED
  LOST
}

class ParcelService {
  - parcels: Map<String, Parcel>
  + registerParcel(parcel: Parcel): void
  + findParcel(number: String): Parcel
  + updateStatus(number: String, status: DeliveryStatus): void
  + getAllParcels(): List<Parcel>
  + getStatistics(): Map<DeliveryStatus, Long>
}

interface DeliveryStrategy {
  + calculateDeliveryCost(parcel: Parcel): double
}

class StandardDeliveryStrategy {
  + calculateDeliveryCost(parcel: Parcel): double
}

class ExpressDeliveryStrategy {
  + calculateDeliveryCost(parcel: Parcel): double
}

class TrackingNumberGenerator {
  + generate(): String
}

class CsvStorage {
  + exportToCsv(): void
}

class ParcelRepository {
  + save(parcel: Parcel): void
  + findByTrackingNumber(number: String): Parcel
}

class TrackingNumberNotFoundException {
  + TrackingNumberNotFoundException(message: String)
}

Person <|-- Sender
Person <|-- Recipient

DeliveryStrategy <|.. StandardDeliveryStrategy
DeliveryStrategy <|.. ExpressDeliveryStrategy

Sender "1" -- "0..*" Parcel : жібереді
Recipient "1" -- "0..*" Parcel : қабылдайды
PostOffice "1" -- "0..*" Parcel : өңдейді

Parcel "1" *-- "0..*" TrackingEvent : тарихы
Parcel --> DeliveryStatus : статус

ParcelService --> ParcelRepository
ParcelService --> TrackingNumberGenerator
ParcelService --> DeliveryStrategy
ParcelService --> CsvStorage
ParcelService ..> TrackingNumberNotFoundException
ParcelService ..> DeliveryStatus

@enduml
