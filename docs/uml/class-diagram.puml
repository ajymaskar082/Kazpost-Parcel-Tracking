
@startuml
skinparam classAttributeIconSize 0
title Қазпошта сәлемдемелерін жеткізу және бақылау жүйесі

abstract class "Тұлға" as Person {
  - атыЖөні: String
  - телефон: String
  + getName(): String
}

class "Жіберуші" as Sender
class "Алушы" as Recipient

Person <|-- Sender
Person <|-- Recipient

class "Сәлемдеме" as Parcel {
  - трекНөмірі: String
  - түрі: String
  - статус: DeliveryStatus
  + getTrackingNumber(): String
}

class "Пошта бөлімшесі" as PostOffice {
  - бөлімшеНөмірі: String
  - мекенжайы: String
  - қаласы: String
}

class "Бақылау оқиғасы" as TrackingEvent {
  - күніУақыты: LocalDateTime
  - сипаттамасы: String
  - статусы: DeliveryStatus
}

enum "Жеткізу статусы" as DeliveryStatus {
  ҚАБЫЛДАНДЫ
  ЖОЛДА
  БӨЛІМШЕГЕ_КЕЛДІ
  ЖЕТКІЗІЛДІ
  ЖОҒАЛДЫ
}

interface "Жеткізу стратегиясы" as DeliveryStrategy {
  + жеткізуКүнінЕсептеу(): int
}

class "Стандартты жеткізу" as StandardDeliveryStrategy
class "Жедел жеткізу" as ExpressDeliveryStrategy

DeliveryStrategy <|.. StandardDeliveryStrategy
DeliveryStrategy <|.. ExpressDeliveryStrategy

class "Сәлемдеме қызметі" as ParcelService {
  - сәлемдемелер: Map
  + сәлемдемеТіркеу(): Parcel
  + сәлемдемеІздеу(): Parcel
  + статустыЖаңарту(): void
}

class "CSV файлмен жұмыс" as CsvStorage {
  + сақтау(): void
  + оқу(): void
}

class "Трек-нөмір табылмады қатесі" as TrackingNumberNotFoundException

Exception <|-- TrackingNumberNotFoundException

Sender "1" -- "0..*" Parcel : жібереді
Recipient "1" -- "0..*" Parcel : қабылдайды
PostOffice "0..1" -- "0..*" Parcel : өңдейді
Parcel "1" *-- "0..*" TrackingEvent : статус тарихы
TrackingEvent --> DeliveryStatus
Parcel --> DeliveryStatus
ParcelService --> Parcel
ParcelService --> CsvStorage
ParcelService ..> DeliveryStrategy
ParcelService ..> TrackingNumberNotFoundException

@enduml
