@startuml
title Қазпошта — Java 17 консольдік жүйесінің Class Diagram-ы
left to right direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle

package "model" {
  abstract class Person {
    - fullName: String
    - phone: String
    - address: String
    + getRoleLabel(): String
    + getFullName(): String
    + getPhone(): String
    + getAddress(): String
    + equals(other: Object): boolean
    + hashCode(): int
  }

  class Sender {
    + getRoleLabel(): String
  }

  class Recipient {
    + getRoleLabel(): String
  }

  class PostOffice {
    - officeCode: String
    - address: String
    - city: String
    + getOfficeInfo(): String
  }

  class Parcel {
    - trackingNumber: String
    - sender: Sender
    - recipient: Recipient
    - postOffice: PostOffice
    - weight: double
    - createdAt: LocalDateTime
    - status: DeliveryStatus
    - trackingHistory: List<TrackingEvent>
    + updateStatus(newStatus: DeliveryStatus, description: String): void
    + getTrackingNumber(): String
    + getStatus(): DeliveryStatus
    + getTrackingHistory(): List<TrackingEvent>
  }

  class TrackingEvent {
    - eventId: long
    - status: DeliveryStatus
    - eventDate: LocalDateTime
    - description: String
    + create(status: DeliveryStatus, description: String): TrackingEvent
    + getEventInfo(): String
  }

  enum DeliveryStatus {
    REGISTERED
    ACCEPTED
    IN_TRANSIT
    ARRIVED_AT_OFFICE
    DELIVERED
    LOST
    --
    + canTransitionTo(next: DeliveryStatus): boolean
    + activeStatuses(): Set<DeliveryStatus>
    + getKazakhLabel(): String
  }
}

package "service and patterns" {
  class ParcelService {
    - repository: ParcelDao
    - parcelFactory: ParcelFactory
    - numberGenerator: TrackingNumberGenerator
    - csvStorage: CsvStorage
    - knownTrackingNumbers: Set<String>
    - deliveryStrategy: DeliveryStrategy
    + registerParcel(sender: Sender, recipient: Recipient, office: PostOffice, weight: double): Parcel
    + findParcel(trackingNumber: String): Parcel
    + getAllParcels(): List<Parcel>
    + getParcelTrackingNumbers(): List<String>
    + updateStatus(trackingNumber: String, status: DeliveryStatus, description: String): void
    + getStatistics(): Map<DeliveryStatus, Long>
    + groupParcelsByStatus(): Map<DeliveryStatus, List<Parcel>>
    + searchByRecipientName(name: String): List<Parcel>
    + calculateDeliveryCost(parcel: Parcel): double
    + setDeliveryStrategy(strategy: DeliveryStrategy): void
    + exportReport(target: Path): void
  }

  interface DeliveryStrategy {
    + calculateDeliveryCost(parcel: Parcel): double
    + getName(): String
  }

  class StandardDeliveryStrategy {
    + calculateDeliveryCost(parcel: Parcel): double
    + getName(): String
  }

  class ExpressDeliveryStrategy {
    + calculateDeliveryCost(parcel: Parcel): double
    + getName(): String
  }

  class ParcelFactory {
    + create(trackingNumber: String, sender: Sender, recipient: Recipient, office: PostOffice, weight: double): Parcel
  }

  class TrackingNumberGenerator {
    - random: SecureRandom
    + generate(): String
    + generateUnique(alreadyExists: Predicate<String>): String
  }

  abstract class "Repository<T>" as Repository {
    + save(entity: T): void
    + findById(id: String): Optional<T>
    + findAll(): List<T>
  }
}

package "persistence" {
  class ParcelDao {
    - database: DatabaseConnection
    + save(parcel: Parcel): void
    + existsByTrackingNumber(number: String): boolean
    + findById(number: String): Optional<Parcel>
    + findAll(): List<Parcel>
    + updateStatus(parcel: Parcel): void
  }

  class DatabaseConnection {
    - jdbcUrl: String
    + getConnection(): Connection
    - initializeSchema(): void
  }

  class CsvStorage {
    + exportToCsv(parcels: List<Parcel>, target: Path): void
    + readCsv(source: Path): List<String[]>
  }

  class AsyncReportService {
    - csvStorage: CsvStorage
    - executor: ExecutorService
    + exportAsync(parcels: List<Parcel>, target: Path): CompletableFuture<Path>
    + close(): void
  }
}

package "console and entry point" {
  class Main {
    + main(args: String[]): void
  }

  class ConsoleMenu {
    - parcelService: ParcelService
    - asyncReportService: AsyncReportService
    - scanner: Scanner
    + run(): void
  }
}

package "exceptions" {
  class TrackingNumberNotFoundException
  class DataAccessException
}

Person <|-- Sender
Person <|-- Recipient
DeliveryStrategy <|.. StandardDeliveryStrategy
DeliveryStrategy <|.. ExpressDeliveryStrategy
Repository <|-- ParcelDao

Sender "1" -- "0..*" Parcel : жіберуші
Recipient "1" -- "0..*" Parcel : алушы
PostOffice "1" -- "0..*" Parcel : бөлімше
Parcel "1" *-- "1..*" TrackingEvent : статус тарихы
Parcel --> DeliveryStatus : ағымдағы статус

ParcelService --> ParcelDao : сақтау/іздеу
ParcelService --> ParcelFactory : объект жасау
ParcelService --> TrackingNumberGenerator : трек-нөмір
ParcelService --> DeliveryStrategy : баға есептеу
ParcelService --> CsvStorage : CSV есеп
ParcelDao --> DatabaseConnection : JDBC
AsyncReportService --> CsvStorage : фондық экспорт
ConsoleMenu --> ParcelService : негізгі әрекеттер
ConsoleMenu --> AsyncReportService : асинхронды экспорт
Main --> DatabaseConnection
Main --> ConsoleMenu
Main --> AsyncReportService
ParcelService ..> TrackingNumberNotFoundException
ParcelDao ..> DataAccessException

note bottom of ParcelService
Collections: List, Set, Map
Stream API: filter, map, groupingBy, counting
end note
@enduml