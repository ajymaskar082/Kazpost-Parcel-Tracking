
@startuml
title Қазпошта — сәлемдемені тіркеу сценарийі

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center

actor "Пошта қызметкері" as Operator
participant "Консольдік мәзір" as Menu
participant "ParcelService" as Service
participant "TrackingNumberGenerator" as Generator
participant "ParcelRepository" as Repository
database "SQLite деректер қоры" as DB
participant "CsvStorage" as CSV

Operator -> Menu : Сәлемдемені тіркеуді таңдау
Menu -> Operator : Жіберуші және алушы мәліметтерін сұрау
Operator -> Menu : Мәліметтерді енгізу

Menu -> Service : registerParcel(parcelData)

Service -> Generator : generate()
Generator --> Service : trackingNumber

Service -> Repository : save(parcel)
Repository -> DB : INSERT INTO parcels
DB --> Repository : Сақтау нәтижесі
Repository --> Service : Сақтау аяқталды

Service -> CSV : exportToCsv()
CSV --> Service : Экспорт нәтижесі

Service --> Menu : Трек-нөмірді қайтару
Menu --> Operator : Сәлемдеме сәтті тіркелді

@enduml
